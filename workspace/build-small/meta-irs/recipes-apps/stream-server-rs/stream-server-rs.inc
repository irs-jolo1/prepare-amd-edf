# cargo-bitbake auto-detected the git remote of the local checkout it was
# generated from (a private repo) and used it as the main SRC_URI. That
# requires SSH access from within bitbake's fetch environment, which does
# not have access to the user's SSH agent/keys (HOME is overridden).
#
# The actual sources are already present locally, so fetch them from the
# recipe's files/ directory instead.
SRC_URI:remove = "git://git@github.com/irs-jolo1/prepare-amd-edf.git;protocol=ssh;nobranch=1"
SRC_URI += "file://stream-server-rs"

S = "${WORKDIR}/stream-server-rs"
CARGO_SRC_DIR = ""

# The industrial-io crate links against libiio (-liio) via pkg-config/bindgen,
# but cargo-bitbake has no way to know about native library dependencies of
# crates, so it never added this. Without it, libiio's headers/.so are never
# staged into the target sysroot and the final link fails with
# "cannot find -liio".
DEPENDS += "libiio"

LIC_FILES_CHKSUM = "file://MIT;md5=f600e2f945b90de826a7c7602ee83f13"

